# Required for the local scaffold
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Required when database-backed modules are implemented. The health endpoint does not connect to MongoDB.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-long-random-secret-before-enabling-sessions

# Required only by later integration modules
RESEND_API_KEY=
RESEND_FROM_EMAIL=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
GOOGLE_PLACES_API_KEY=
