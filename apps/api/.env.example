## Local API settings
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Required to start the API. Use your local MongoDB URI or an Atlas connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Optional comma-separated DNS server IPs for mongodb+srv lookups. Set only if Node cannot use the system resolver.
MONGODB_DNS_SERVERS=

# Required for password-reset and wedding-member invitation email delivery.
# Verify the sender domain in Resend, then use a from-address on that domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
GOOGLE_PLACES_API_KEY=
